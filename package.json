{
	"name": "obsidian-background-cover",
	"version": "1.0.0",
	"description": "Obsidian plugin: customize background with a local image folder. Only loads the currently used image into memory; supports folders outside the vault; fixed-interval auto rotation; does not modify theme variables.",
	"author": "Lose-Memory",
	"main": "main.js",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Lose-Memory/obsidian-background-cover.git"
	},
	"homepage": "https://github.com/Lose-Memory/obsidian-background-cover#readme",
	"bugs": {
		"url": "https://github.com/Lose-Memory/obsidian-background-cover/issues"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"background",
		"wallpaper",
		"background-image"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
